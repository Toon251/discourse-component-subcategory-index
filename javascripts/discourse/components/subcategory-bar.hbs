{{#if this.show}}
    <!--<div>Subcategory indexes : {{this.currentCategoryId}}</div>-->
    <!--<div>Filter : {{this.letterFilter}}</div>-->
    <!--<div>Slug : {{this.parentSlug}}</div>-->
    {{#conditional-loading-spinner condition=this.isLoading}}
        
        <div class='subcategory-bar__wrapper {{settings.plugin_outlet}}'>
            <div class="subcategory-bar__container_search">
                <div class="input-container">
                    <input value={{this.tmpWordFilter}} oninput={{action "handleInputFilter"}} aria-controls="search-result-count" aria-label="enter search keyword" enterkeyhint="search" autocomplete="off" placeholder="Search" id="ember206" class="ember-text-field ember-view full-page-search search no-blur search-query input-search" type="search">
                </div>
                
                <button class="btn btn-icon-text btn-primary search-cta" aria-label="Search" type="button" {{action "submitFilter"}}>
                    <svg class="fa d-icon d-icon-magnifying-glass svg-icon svg-string" xmlns="http://www.w3.org/2000/svg"><use href="#magnifying-glass"></use></svg>      <span class="d-button-label">Search<!----></span>
                </button>
            </div>

            {{#if this.noFilter }}
                <div class="filter-word">
                    ตัวกรอง : แสดงทั้งหมด
                </div>
            {{/if}}

            {{#if (not (eq this.wordFilter "")) }}
                <div class="filter-word">
                    ตัวกรอง : ค้นหาคำ "*{{this.wordFilter}}*"
                </div>
            {{/if}}

            {{#if (not (eq this.letterFilter "")) }}
                <div class="filter-word">
                    ตัวกรอง : ค้นหาที่ขึ้นต้นด้วย : "{{this.letterFilter}}"
                </div>
            {{/if}}

            <div class='subcategory-bar__container'>
                <div class='subcategory-bar__index'>
                    <div>
                        <a {{on 'click' (fn this.setNoFilter) }}>{{letter}} ทั้งหมด </a> ({{this.letterIndexes.length}})
                    </div>
                    {{#each this.letterIndexes as |letter|}}
                        <div class="index-link">
                            <a {{on 'click' (fn this.filterLetter letter) }}>{{letter}}</a>
                        </div>
                    {{/each}}
                    
                </div>
            </div>
            <!-- Category list -->
            <div class="subcategory-bar__grid-container">
            
                {{#each this.filterData as |sc|}}
                    <div {{on 'click' (fn this.goSubcategory  sc.slug ) }} class="subcategory-bar__grid-item">
                                <span class="cat-title">{{sc.name}}</span>
                                <span class="cat-subtitle">
                                    : {{sc.description}}
                                </span>
                            </div>
                {{/each}}
            </div>
            <!-- Page navigation -->
            <div class='subcategory-bar__container_pagination'>
                <div class="page-size-selection">
                    <label for="size-list">แสดง:</label>
                    <select id="size-list" class="pagesize-dropdown">
                        {{#each this.pageSizeOptions as |s|}}
                            <option value="{{s}}">{{s}}</option>
                        {{/each}}
                    </select>
                    <details id="ember632" class="select-kit single-select combobox combo-box has-selection ember-view">  <summary aria-label="Filter by: ปานกลาง" name="Filter by: ปานกลาง" data-name="ปานกลาง" data-value="6" tabindex="0" role="listbox" id="ember632-header" class="select-kit-header single-select-header combo-box-header ember-view"><div class="select-kit-header-wrapper">
  <!---->

    <div title="ปานกลาง" data-value="6" data-name="ปานกลาง" class="select-kit-selected-name selected-name choice">
<!---->
<!---->
    <span class="name">
      ปานกลาง
    </span>

<!---->  </div>


<!---->
  <svg class="fa d-icon d-icon-caret-down svg-icon caret-icon svg-string" xmlns="http://www.w3.org/2000/svg"><use href="#caret-down"></use></svg>
</div></summary>

  <div id="ember632-body" class="select-kit-body ember-view" style="position: fixed; min-width: 565.656px; inset: 0px auto auto 0px; margin: 0px; transform: translate3d(587.5px, 447px, 0px);" data-popper-placement="bottom-start"><!----></div>
</details>
                </div>
                <div class="page-head">
                    <span>หน้า {{this.currentPage}}/{{this.totalPage}}</span> 
                    <span>ทั้งหมด {{this.records}} รายการ</span>
                </div>
                <div class="page-navigator">
                    <div {{on 'click' this.prevPage}} class="{{if (eq this.currentPage 1) 'disabled-link' 'enabled-link'}}">
                        ก่อนหน้า
                    </div>
                    <div class="page-index" >
                        {{#each this.pages as |p|}}
                            {{#if (not (eq p "..."))}}
                                <span {{on 'click' (fn this.goToPage p) }} class="{{if (eq this.currentPage p) 'page-item-selected' 'page-item'}}" >
                                    <span>{{p}}</span>
                                </span>
                            {{/if}}
                            {{#if (eq p "...")}}
                                <span class="page-item">...</span>
                            {{/if}}
                        {{/each}}
                    </div>
                    <div {{on 'click' this.nextPage}} class="{{if (eq this.currentPage this.totalPage) 'disabled-link' 'enabled-link'}}">
                        ถัดไป
                    </div>
                </div>

            </div>
        </div>
        
    {{/conditional-loading-spinner}}
{{else}}
    <!--<div>
        Hidden
    </div>-->
{{/if}}