{{#if this.show}}
    <!--<div>Subcategory indexes : {{this.currentCategoryId}}</div>-->
    <!--<div>Filter : {{this.letterFilter}}</div>-->
    <!--<div>Slug : {{this.parentSlug}}</div>-->
    {{#conditional-loading-spinner condition=this.isLoading}}
        
        <div class='subcategory-bar__wrapper {{settings.plugin_outlet}}'>
            <div class="subcategory-bar__container_search">
                <div class="input-container">
                    <input value={{this.wordFilter}} oninput={{action "handleInputFilter"}} aria-controls="search-result-count" aria-label="enter search keyword" enterkeyhint="search" autocomplete="off" placeholder="Search" id="ember206" class="ember-text-field ember-view full-page-search search no-blur search-query input-search" type="search">
                </div>
                
                <button class="btn btn-icon-text btn-primary search-cta" aria-label="Search" type="button" {{action "submitFilter"}}>
                    <svg class="fa d-icon d-icon-magnifying-glass svg-icon svg-string" xmlns="http://www.w3.org/2000/svg"><use href="#magnifying-glass"></use></svg>      <span class="d-button-label">Search<!----></span>
                </button>
            </div>

            {{#if (not (eq this.wordFilter "")) }}
                <div class="filter-word">
                    ค้นหาคำ "*{{this.wordFilter}}*"
                </div>
            {{/if}}

            {{#if (not (eq this.letterFilter "")) }}
                <div class="filter-word">
                    ค้นหาที่ขึ้นต้นด้วย : "{{this.letterFilter}}"
                </div>
            {{/if}}

            <div class='subcategory-bar__container'>
                <div class='subcategory-bar__index'>
                    <div>
                        <a {{on 'click' (fn this.filterLetter "" ) }}>{{letter}} ทั้งหมด </a> ({{this.letterIndexes.length}})
                    </div>
                    {{#each this.letterIndexes as |letter|}}
                        <div class="index-link">
                            <a {{on 'click' (fn this.filterLetter letter) }}>{{letter}}</a>
                        </div>
                    {{/each}}
                    
                </div>
            </div>
        </div>
        <div class="subcategory-bar__grid-container">
            
            {{#each this.subcategories as |sc|}}
            
                {{#if (this.isLetterFilter sc.name this.letterFilter) }}


                    <div {{on 'click' (fn this.goSubcategory  sc.slug ) }} class="subcategory-bar__grid-item">
                        <span style="font-weight:bold">{{sc.name}}</span>
                        <span>
                            {{sc.description}}
                        </span>
                    </div>
                {{/if}}
            {{/each}}
        </div>
        <div class='subcategory-bar__container_pagination'>
            <div>
                หน้า {{this.currentPage}}/{{this.totalPage}} จาก {{getTotalFilters}} รายการ
            </div>
            <div class="page-navigator">
                <div>
                    ก่อนหน้า
                </div>
                <div class="page-index">
                    <span class="{{if (fn this.isCurrentPage this.currentPage 1) 'page-item-selected' 'page-item'}}">
                        <a {{on 'click' (fn this.goToPage 1) }}>1</a>
                    </span>
                    <span class="{{if (fn this.isCurrentPage this.currentPage 2) 'page-item-selected' 'page-item'}}">
                        <a {{on 'click' (fn this.goToPage 2) }}>2</a>
                    </span>
                    <span class="page-item">...</span>
                    <span class="{{if (fn this.isCurrentPage this.currentPage 4) 'page-item-selected' 'page-item'}}">
                        <a {{on 'click' (fn this.goToPage 4) }}>4</a>
                    </span>
                </div>
                <div>
                    ถัดไป
                </div>
            </div>

        </div>
    {{/conditional-loading-spinner}}
{{else}}
    <!--<div>
        Hidden
    </div>-->
{{/if}}